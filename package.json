{
  "name": "markdown-to-doc",
  "version": "1.1.3",
  "description": "Convert Markdown to DOCX (Word) documents in Node.js and Bun - styled output, tables, code highlighting, images, headers/footers, and a CLI.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "markdown-to-doc": "./dist/cli/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Nilesh9106/markdown-to-doc.git"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/bun": "latest",
    "@types/mdast": "^4.0.4",
    "tsup": "^8.5.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "docx": "^9.5.1",
    "image-size": "^2.0.2",
    "jszip": "^3.10.1",
    "lowlight": "^3.3.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "bugs": {
    "url": "https://github.com/Nilesh9106/markdown-to-doc/issues"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.1.0"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/Nilesh9106/markdown-to-doc#readme",
  "keywords": [
    "markdown",
    "docx",
    "word",
    "doc",
    "convert",
    "converter",
    "markdown-to-docx",
    "markdown-to-word",
    "md-to-docx",
    "md-to-word",
    "markdown-to-doc",
    "docx-generator",
    "document-generation",
    "report-generator",
    "office",
    "ooxml",
    "remark",
    "mdast",
    "typescript",
    "cli",
    "bun",
    "nodejs"
  ],
  "license": "MIT",
  "scripts": {
    "build": "bunx --bun tsup src/index.ts --format esm,cjs --clean && bunx --bun tsup src/cli/index.ts --format esm --out-dir dist/cli && bunx --bun tsc --emitDeclarationOnly --noEmit false --outDir dist",
    "example": "bun run examples/markdown-to-docx.ts",
    "test": "bun test",
    "typecheck": "bunx --bun tsc --noEmit && bunx --bun tsc --noEmit -p tsconfig.test.json",
    "lint": "bunx --bun @biomejs/biome check .",
    "lint:fix": "bunx --bun @biomejs/biome check --write .",
    "format": "bunx --bun @biomejs/biome format --write .",
    "clean": "rm -rf dist",
    "ci:check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "prepublishOnly": "bun run ci:check",
    "publish:npm": "npm publish --access public",
    "release": "bun run scripts/release.ts"
  },
  "sideEffects": false
}
